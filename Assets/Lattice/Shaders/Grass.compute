// Lattice: grass clumps on the ground near the camera (World/GrassField.cs).
// One thread per cell of a grid anchored in the world around the camera: a
// clump lands in a cell with the chance the ground's grass and meadow give it,
// thinned with distance (the clumps kept are widened to fill in), at a spot,
// size and turn hashed from the cell, so clumps stay put as the camera moves.
// Culled to the view and appended for one indirect draw (Lattice/Grass).
#pragma kernel Scatter

struct Clump
{
    float3 pos;     // Unity world space, on the ground
    float yaw;      // radians
    float height;   // m
    float width;    // blade width, x the mesh's
    float tint;     // 0 green grass .. 1 dry meadow
    float phase;    // wind phase
};

AppendStructuredBuffer<Clump> _Clumps;
// The game's height grid (m, 4 m spacing) and the ground's grass at 4 m
// texels: x how much is grass or meadow, y the meadow's share of it.
Texture2D<float> _Heights;
Texture2D<float2> _GrassMap;
SamplerState linear_clamp_sampler;

float4 _Grid;    // x, y: the grid's first cell (Unity x, z), z: cell size (m), w: cells per side
float4 _Eye;     // xyz: the camera (Unity), w: how far grass grows (m)
float4 _Thin;    // x: thinning starts (m), y: share kept at the edge, z: clumps per cell on full grass, w: seed
float4 _Size;    // x, y: clump height range (m), z, w: width range
float4 _Map;     // x: half the world (m), y: height spacing (m), z: height samples per side, w: the world (m)
float4 _Planes[6];

uint Hash(int2 c, uint seed)
{
    uint h = (uint)c.x * 0x8DA6B343u ^ (uint)c.y * 0xD8163841u ^ seed;
    h ^= h >> 15; h *= 0x2C1B3C6Du;
    h ^= h >> 12; h *= 0x297A2D39u;
    h ^= h >> 15;
    return h;
}

// PCG: the next number in [0, 1).
float Next(inout uint h)
{
    h = h * 747796405u + 2891336453u;
    uint w = ((h >> ((h >> 28u) + 4u)) ^ h) * 277803737u;
    return ((w >> 22u) ^ w) * (1.0 / 4294967296.0);
}

[numthreads(8, 8, 1)]
void Scatter(uint3 id : SV_DispatchThreadID)
{
    uint n = (uint)_Grid.w;
    if (id.x >= n || id.y >= n)
        return;
    int2 cell = int2(_Grid.xy) + int2(id.xy);
    uint h = Hash(cell, (uint)_Thin.w);
    float2 p = (float2(cell) + float2(Next(h), Next(h))) * _Grid.z;
    float dist = distance(p, _Eye.xz);
    if (dist > _Eye.w)
        return;
    float2 game = p + _Map.x;
    float2 g = _GrassMap.SampleLevel(linear_clamp_sampler, game / _Map.w, 0);
    float keep = lerp(1.0, _Thin.y, saturate((dist - _Thin.x) / (_Eye.w - _Thin.x)));
    float chance = saturate(g.x * _Thin.z) * keep;
    float r = Next(h);
    if (r >= chance)
        return;
    float y = _Heights.SampleLevel(linear_clamp_sampler, (game / _Map.y + 0.5) / _Map.z, 0);
    float3 pos = float3(p.x, y, p.y);
    [unroll]
    for (int i = 0; i < 6; i++)
        if (dot(_Planes[i].xyz, pos) + _Planes[i].w < -0.8)
            return;

    Clump c;
    c.pos = pos;
    c.yaw = Next(h) * 6.2831853;
    // A clump grows in as its chance passes it (thinning moves with the camera),
    // shrinks away at the field's edge, and stays short where grass is sparse.
    float grow = saturate((chance - r) / max(0.2 * chance, 1e-4));
    float edge = 1.0 - smoothstep(_Eye.w * 0.7, _Eye.w, dist);
    float sparse = lerp(0.5, 1.0, saturate(g.x * 1.5));
    c.height = lerp(_Size.x, _Size.y, Next(h)) * lerp(1.0, 1.3, g.y) * sparse * grow * edge;
    c.width = lerp(_Size.z, _Size.w, Next(h)) * rsqrt(keep);
    c.tint = saturate(g.y + (Next(h) - 0.5) * 0.35);
    c.phase = Next(h) * 6.2831853;
    _Clumps.Append(c);
}
